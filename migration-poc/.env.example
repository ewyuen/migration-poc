# OpenRouter API Configuration
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL=deepseek/deepseek-chat

# Extraction settings
TARGET_FRAMEWORK=net10.0
COMPLIANCE_CONTEXT=21 CFR Part 11
DOMAIN=medical/chromatography

# Local Langfuse debug setup
# Project-scoped keys from the Langfuse UI
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_ENDPOINT=http://localhost:3000

# Collector bridge auth header value.
# Generate with: [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes("pk-lf-...:sk-lf-..."))
# Paste the generated base64 output directly. Do not use base64(...) or ${...} expressions.
LANGFUSE_AUTH_STRING=

# App exports OTLP gRPC to the local collector on port 4317
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
